{
  "name": "luxecms",
  "version": "0.0.2-beta.0",
  "description": "The first truly composable headless CMS built for the modular web.",
  "type": "module",
  "scripts": {
    "dev": "luxe-scripts dev --dts",
    "build": "luxe-scripts build --dts",
    "test": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./modules": {
      "types": "./dist/types/modules/index.d.ts",
      "import": "./dist/esm/modules/index.mjs",
      "require": "./dist/cjs/modules/index.cjs"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/stack-utils": "^2.0.3",
    "@vitest/coverage-v8": "^2.1.8",
    "luxe-scripts": "workspace:*",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "error-stack-parser": "^2.1.4",
    "kleur": "^4.1.5",
    "stack-utils": "^2.0.6",
    "zod": "^3.23.8"
  },
  "overrides": {
    "vite": "5.4.10"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
